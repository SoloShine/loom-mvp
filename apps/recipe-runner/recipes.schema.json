{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://loom-mvp.local/schemas/recipe.schema.json",
  "title": "loom recipe",
  "description": "recipe 声明式工具层的唯一事实源。文本是可信内容（信任模型与 App 代码等同，PRD §16），schema 只拦截结构错误，不做沙箱。agent 生成 recipe 时直接以本文件为准。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "recipe 稳定 id，与文件名一致；launcher / invoke / 热键注册都靠它寻址"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "展示名；缺省用 id"
    },
    "hotkey": {
      "type": "string",
      "minLength": 1,
      "description": "可选全局热键（如 Ctrl+Alt+R）。runner 经 host.hotkey.register 动态注册，先到先得不抢占"
    },
    "onRun": {
      "enum": ["silent", "ask"],
      "default": "silent",
      "description": "silent（缺省）= 热键/launcher 触发时按取值链静默启动；ask = 触发先弹参数表单。required 参数无值时无论何种模式都弹表单"
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
        "description": "参数名必须是合法 JS 标识符（表达式里以 params.<名> 引用）"
      },
      "additionalProperties": { "$ref": "#/definitions/param" },
      "description": "启动表单参数。取值链 per-run override > preset > lastUsed > default"
    },
    "onerror": {
      "enum": ["notify", "silent"],
      "default": "notify",
      "description": "错误即停后是否发失败摘要通知（含失败步 id 与错误消息）"
    },
    "limits": {
      "$ref": "#/definitions/limits",
      "description": "保护参数覆盖。缺省：迭代上限 1000、单步 30s、ui.* 类 120s、run 总超时 10min"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" },
      "description": "线性顺序执行；每步必有稳定短 id（输出引用 / 错误定位 / AI 指代）"
    }
  },
  "definitions": {
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "label": { "type": "string", "description": "表单标签；缺省用参数名" },
        "type": {
          "enum": ["string", "number", "boolean", "select"],
          "description": "params 表单与 ui.ask 共用同一 schema→form 渲染器"
        },
        "default": { "description": "声明默认值（取值链最底层）；类型应与 type 一致" },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "必填参数无值时无论 onRun 何种模式都先弹表单"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["value"],
                "properties": {
                  "value": { "type": "string" },
                  "label": { "type": "string" }
                }
              }
            ]
          },
          "description": "type=select 时的候选项；纯字符串或 {value,label}"
        }
      },
      "if": { "properties": { "type": { "const": "select" } } },
      "then": { "required": ["options"] }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxIterations": { "type": "integer", "minimum": 1 },
        "stepTimeoutMs": { "type": "integer", "minimum": 1 },
        "uiStepTimeoutMs": { "type": "integer", "minimum": 1 },
        "runTimeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "exprTpl": {
      "type": "string",
      "pattern": "\\{\\{[\\s\\S]+\\}\\}",
      "description": "含 {{ 表达式 }} 的模板字符串。整个值恰为单一 {{ }} 时求值结果保持原始类型，否则按字符串插值"
    },
    "for": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "each": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
          "not": { "enum": ["params", "steps", "env"] },
          "description": "循环变量名；不得与表达式上下文名（params/steps/env）或 JS 保留字冲突"
        },
        "in": {
          "$ref": "#/definitions/exprTpl",
          "description": "求值结果必须是数组（如 {{steps.list.files}}）"
        },
        "times": {
          "anyOf": [
            { "type": "integer", "minimum": 0 },
            { "$ref": "#/definitions/exprTpl" }
          ],
          "description": "固定次数循环（宏/连招场景）"
        }
      },
      "oneOf": [
        {
          "required": ["each", "in"],
          "not": { "required": ["times"] },
          "description": "遍历集合形态"
        },
        {
          "required": ["times"],
          "not": { "anyOf": [{ "required": ["each"] }, { "required": ["in"] }] },
          "description": "固定次数形态"
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
          "description": "步骤稳定短 id；全 recipe 内唯一（含循环体）；输出以 steps.<id>.<out> 引用"
        },
        "action": { "type": "string", "minLength": 1 },
        "args": {
          "type": "object",
          "description": "实参模板：字符串值支持 {{ }} 插值；输入统一写在 args（不设 from: 字段）"
        },
        "out": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
          "description": "输出落点重命名：缺省存 steps.<id>.out，声明后存 steps.<id>.<out>"
        },
        "when": {
          "anyOf": [
            { "type": "boolean" },
            {
              "type": "string",
              "pattern": "^\\s*\\{\\{[\\s\\S]+\\}\\}\\s*$",
              "description": "条件必须是单一 {{ 表达式 }}（或布尔字面量），求值结果按 JS 真值判定；假值跳过该步（status: skipped）"
            }
          ]
        },
        "for": { "$ref": "#/definitions/for" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/step" },
          "description": "循环体。唯一允许的嵌套层：控制流不套控制流（体内步骤不得再带 for）"
        }
      },
      "anyOf": [
        {
          "required": ["action"],
          "not": { "required": ["for"] },
          "description": "动作叶子：执行一次 action"
        },
        {
          "required": ["for", "steps"],
          "not": { "required": ["action"] },
          "description": "循环容器：不带自身 action，按 for 声明执行子步骤"
        }
      ]
    }
  }
}
